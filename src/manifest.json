{
  "manifest_version": 3,
  "name": "inlineNotes",
  "version": "0.1.0",
  "description": "Личные заметки прямо на странице статьи.",
  "permissions": ["storage", "tabs"],
  "icons": {
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "inlineNotes",
    "default_icon": {
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
