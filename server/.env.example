# Copy to `.env` for a local, non-compose run:
#
#   docker run --rm --env-file .env -p 8080:8080 inlinenotes-server
#
# The compose file sets these values itself; `.env` is for running the binary or
# the image outside compose.

# PostgreSQL connection string. `sslmode=disable` is for a local container only.
DATABASE_URL=postgres://inlinenotes:inlinenotes@localhost:5432/inlinenotes?sslmode=disable

# Port the HTTP API listens on.
PORT=8080

# Read by the store tests only (`go test ./...`). When empty, the store suite
# skips and the handler/model suites still run.
TEST_DATABASE_URL=postgres://inlinenotes:inlinenotes@localhost:5432/inlinenotes?sslmode=disable
